views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Sessions")
        - "!Characters.isEmpty()"
    order:
      - file.name
      - Attended?
      - Characters
      - Location
      - Starting Point
    sort: []
    columnSize:
      file.name: 186
  - type: table
    name: View
    filters:
      and:
        - file.inFolder("Sessions")
    order:
      - file.name
      - Location
      - Characters
      - Starting Point
    columnSize:
      note.Characters: 280
