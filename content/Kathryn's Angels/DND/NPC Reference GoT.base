views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("DND/NPCs")
    order:
      - file.name
      - Last seen?
      - Met in
      - Lives
      - Race
      - Dead?
      - aliases
    sort:
      - property: Last seen?
        direction: DESC
    columnSize:
      note.Last seen?: 112
      note.Met in: 281
      note.Race: 156
      note.Dead?: 73
  - type: cards
    name: View
